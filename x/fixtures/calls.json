    "data": {
        "brief check": "{ brief, checked, repo, sha256, stamp, unchecked } — on a miss: failed, the error lists each line, kind and name",
        "completion": "{ shell, script }",
        "handoff ingest": "{ name, slug, kept, body } — the file is deleted unless shared (kept: true)",
        "handoff list": "{ root, entries: [{ name, slug, audience, lane, author, shared, age, stale, bytes, runId }], others: [same] } — newest first; `others` holds what --for <audience> filtered out, [] without --for",
        "handoff peek": "{ name, slug, age, bytes, meta } — meta is the META block as markdown, null when the CST has none",
        "knowledge list": "{ files: [{ name, purpose, verified, refreshWhen, bytes }], root }",
        "knowledge read": "{ body, name, path, verified } — the read is logged to $X_STATE/knowledge-reads.jsonl",
        "lane commit": "{ branch, sha, tree }",
        "lane commit --hold-unstaged": "{ branch, sha, tree } — the files outside the paths are back byte for byte",
        "lane merge-main": "{ sha }",
        "lane pr-open plan": "{ branch, argv }",
        "lane push": "{ branch, sha, remote, from }",
        "lane push plan": "{ branch, sha, from, reason }",
        "lane unlock": "{ tree, unlocked }",
        "overview": "{ groups: { <family>: [{ name, purpose }] } }",
        "probe bare": "{ answer, costUsd, cwd, model, ms, sessionId, tokens }",
        "probe session": "{ answer, costUsd, dir, model, ms, name, resumed, sessionId, tokens, transcript? }",
        "schema": "{ verbs: [...] } — --level full (default): each verb's whole schema; --level short: [{ name, purpose }]"
    },
    "env": {
        "CLAUDECODE": "unset in every call except `json-by-agent-env`",
        "HANDOFF_STORE_ROOT": "{world}/store",
        "NO_COLOR": "unset in tty calls, so colour shows",
        "X_KNOWLEDGE_ROOT": "{world}/knowledge in every call, so the shelf is the fixture's",
        "X_STATE": "{world}/state in every call: stamps, probes and the read log stay in the world"
    },
    "envelope": {
        "keys": "key order is not contract: compare parsed json, never bytes",
        "next": "on failed, usage and confirm: the one command that moves the caller forward",
        "raw": "a verb whose human view is raw text (completion) prints it raw on a pipe; --json or CLAUDECODE/AI_AGENT still give the envelope",
        "shape": "{ verb, x, ok, status, data | plan | error, next? } — one line of json on stdout, nothing else on stdout",
        "status": "ok → exit 0 · failed → exit 1 · usage → exit 2 · confirm → exit 4"
    },
    "modes": {
        "json": "a terminal, with --json in argv; the json envelope, no prompt ever",
        "pipe": "stdout is a pipe, stdin is /dev/null; the json envelope, no prompt ever",
        "tty": "stdin and stdout are a terminal (vhs, or a pty); the human view"
    },
    "volatile": [
        "x",
        "data.sha",
        "data.remote",
        "data.tree",
        "data.from",
        "data.root",
        "data.entries[].age",
        "data.entries[].stale",
        "data.age",
        "plan.sha",
        "plan.from"
    ]
}
