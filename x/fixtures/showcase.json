{
    "about": "FRM-284 look probe: one showcase per arm, shot by shoot.sh with CALLS=x/fixtures/showcase.json XNAME=showcase-<arm>. the app call's png is the first frame, before any key",
    "calls": [
        {
            "argv": ["--static"],
            "cols": 124,
            "id": "showcase-static",
            "mode": "tty",
            "rows": 46
        },
        {
            "argv": [],
            "cols": 124,
            "id": "showcase-app",
            "keys": [
                "Space",
                "Down",
                "Space",
                "Down",
                "Down",
                "Space",
                "Enter"
            ],
            "mode": "tty",
            "rows": 46
        }
    ]
}
