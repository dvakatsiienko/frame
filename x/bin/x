#!/usr/bin/env bash
# x — runs the go binary of the nearest frame tree above the cwd, so a worktree runs its own edits;
# anywhere else (bytes, ~) it runs the checkout this shim lives in. the binary is rebuilt first when
# it is missing or older than any of its source files, so a merge or an edit never runs stale code.
dir=${PWD}
while [[ ${dir} != / && ! (-f ${dir}/x/go/go.mod && -x ${dir}/x/bin/x) ]]; do
    dir=${dir%/*}
    [[ -z ${dir} ]] && dir=/
done
if [[ ${dir} == / ]]; then
    here=$(realpath "${BASH_SOURCE[0]}")
    dir=${here%/x/bin/x}
fi
go=${dir}/x/go
bin=${go}/bin/x

stale=0
[[ -x ${bin} ]] || stale=1
for file in "${go}"/*.go "${go}"/registry.json "${go}"/go.mod "${go}"/go.sum; do
    ((stale)) && break
    [[ ${file} -nt ${bin} ]] && stale=1
done
if ((stale)); then
    gobin=$(command -v go || echo /opt/homebrew/bin/go)
    echo "x: building from ${go} with ${gobin}" >&2
    # a dev build: x/go differs from origin/main — an edit, an untracked file or an unpushed commit.
    # `x stats` leaves its trace lines out; a git that fails reads as not dev
    dev=
    git -C "${dir}" diff --quiet origin/main -- x/go 2>/dev/null
    if (($? == 1)) || [[ -n $(git -C "${dir}" ls-files --others --exclude-standard -- x/go 2>/dev/null) ]]; then
        dev=1
    fi
    # a temp file then a rename: two shells building at once never run a half-written binary
    if (cd "${go}" && "${gobin}" build -trimpath -ldflags "-s -w -X main.srcDir=${go} -X main.devBuild=${dev}" -o "bin/.x.$$" . && mv -f "bin/.x.$$" bin/x) >&2; then
        :
    elif [[ -x ${bin} ]]; then
        echo "x: the build failed — running the last binary" >&2
    else
        exit 1
    fi
fi
exec "${bin}" "$@"
