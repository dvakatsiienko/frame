{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

  "extends": ["biome-config-polished"],

  // `@theme`, `@source`, `@custom-variant` and friends are tailwind v4 at-rules, and the css
  // parser reads them as syntax errors until it is told. bytes gets this from ultracite;
  // frame extends only polished, so it says so itself.
  "css": { "parser": { "tailwindDirectives": true } },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!**/public/**/*",
      "!.claude/worktrees", // coder worktrees carry their own biome.jsonc — a nested root otherwise
      "!assets", // generated readme art: mac.svg keeps ascii spacing under xml:space, a reformat breaks it
      "!home/.claude/sline/showcase/sline.svg", // rendered by render-svg.ts, never hand-edited
      "!brand", // generated avatar and brand art (svg + png), never hand-formatted

      // Not ours to format — editor/app config consumed verbatim, and themes
      // whose diffs would be pure noise.
      //
      // The Claude Code entries are a CLASS, not a list: anything under a
      // `.claude/` or `.claude-plugin/` directory is written by the CLI itself
      // (plugin install, skill overrides, runtime settings). Formatting one
      // starts a churn loop between two owners, and the loser is the pre-commit
      // hook, which fails without printing an error. Globbed rather than
      // enumerated so the next such file needs no edit here.
      "!**/import",
      // …except the raycast extensions under it: those are source we write here, not
      // config consumed verbatim. The blanket above had silently excluded them.
      //
      // The ancestors are listed one by one on purpose: biome stops descending at an
      // excluded DIRECTORY, so a lone `import/raycast/extensions/**` never matches —
      // each directory on the way down has to win a later pattern first.
      "import",
      "import/raycast",
      "import/raycast/extensions",
      "import/raycast/extensions/**",
      "!home/.claude/themes",
      "!**/.claude/*.json",
      "!**/.claude-plugin",
      "!**/skills-lock.json", // the `skills` cli's lockfile, same class

      // Same class, different author: the shelf holds what the AGENTS produce
      // — transcript metadata, flaw logs. Written by tools, read by tools, and
      // reformatting a store nobody hand-edits is the same two-owner churn.
      "!home/.claude/shelf",
      // workflow scripts run in cc's sandbox, which wraps them in an async function — a
      // top-level `return` is legal there and a parse error for biome
      "!home/.claude/workflows",

      // Same two-owner churn again, this time with a raycast command as the other owner: the
      // «gmail: block sender» extension rewrites this store with `JSON.stringify(…, null, 4)`,
      // which never collapses an array, and biome's formatter collapses every one that fits.
      // Neither side yields, so every block through raycast left the repo un-committable until
      // someone reformatted by hand. Teaching the writer biome's shape does not hold either —
      // biome re-expands an array once the line passes 80 columns, about three addresses from
      // now. The store is machine-written and jsonnet-read; biome owning it buys nothing.
      "!gmail/blocklist.json",

      // Upstream's, not ours: lazy-lock.json is rewritten by lazy.nvim on every
      // sync, so formatting it just starts a fight. The lua there has its own
      // stylua.toml.
      "!home/.config/nvim"
    ]
  },

  "overrides": [
    {
      // Two shapes the dependency rule cannot see.
      //
      // The vite config imports the bundler and its plugins, which are workspace-root
      // devDependencies on purpose — one version, one renovate PR — so the app's own manifest
      // does not declare them. That is the shape we want, not a mistake.
      //
      // `src` imports `@hotkeys/*`, a tsconfig path alias to the modules chord.ts and manual.ts,
      // which the node side of this feature shares. In bytes the same ergonomic (`@ui/kit/*`)
      // points at a real workspace package, so the rule is satisfied there; here the target is a
      // plain directory and never can be. The cost is that a genuinely missing npm dependency in
      // src would not be caught here — typecheck and the build both still catch it.
      "includes": ["hotkeys/chords/vite.config.ts", "hotkeys/chords/src/**"],
      "linter": {
        "rules": { "correctness": { "noUndeclaredDependencies": "off" } }
      }
    },
    {
      // Two raycast contracts the default rules read as mistakes: a command file is an entry
      // point raycast loads by default export, and react is supplied by the raycast runtime
      // rather than bundled, so the official extension template never declares it.
      "includes": ["import/raycast/extensions/**"],
      "linter": {
        "rules": {
          "correctness": { "noUndeclaredDependencies": "off" },
          "style": { "noDefaultExport": "off" }
        }
      }
    }
  ],

  "vcs": {
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true,
    "useIgnoreFile": true
  }
}
