{
    "compilerOptions": {
        "lib": ["ESNext"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "esnext",
        "types": ["node"],

        "strict": true,
        "noUncheckedIndexedAccess": true,

        // Node runs these files by stripping types, never compiling them — so any
        // syntax that would need emitted code is banned outright.
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,

        "noEmit": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    },
    // `hotkeys/*.ts` is the node side of that feature and belongs here: same runtime, same
    // erasable-syntax rule. A single `*` does not recurse, so `hotkeys/chords` keeps its own
    // tsconfig — that one is a browser app. Until this line existed nothing typechecked those
    // files at all, and a field deleted from an interface stayed green through the whole gate.
    "include": [
        "script/**/*.ts",
        "hotkeys/*.ts",
        "speak/server.ts",
        "schedule/*.ts",
        "design/**/*.ts",
        "brand/profile/*.ts",
        "ccrow/*.ts",
        "home/.claude/plugin-x/lib/*.ts",
        "home/.claude/plugin-x/skills/*/scripts/*.ts",
        "home/.claude/plugin-x/mods/*.ts",
        "logos/*.ts",
        "x/*.ts",
        "x/go/*.ts"
    ]
}
