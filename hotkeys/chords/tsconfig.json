{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleDetection": "force",
        "moduleResolution": "bundler",
        "noEmit": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2023",
        "types": ["vite/client", "@webgpu/types", "@vgpu/wgsl/wgsl-types"],
        "paths": {
            "@/*": ["./src/*"],
            "@hotkeys/*": ["../*"]
        },
        "verbatimModuleSyntax": true
    },
    "include": [
        "src",
        "vite.config.ts",
        "../ports.ts",
        "../chord.ts",
        "../manual.ts"
    ]
}
