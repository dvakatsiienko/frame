{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleDetection": "force",
        "moduleResolution": "bundler",
        "noEmit": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2023",
        "types": ["vite/client"],
        "paths": {
            "@/*": ["./src/*"]
        },
        "verbatimModuleSyntax": true
    },
    // server.ts is node and sits in frame's root tsconfig, beside the other node scripts
    "include": ["src", "vite.config.ts", "ports.ts"]
}
