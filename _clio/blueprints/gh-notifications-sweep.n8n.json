          "mode": "id",
          "value": "mglcjPmgZRSBZTai"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "thread",
              "condition": "eq",
              "keyValue": "={{ $json.thread }}"
            },
            {
              "keyName": "updated_at",
              "condition": "eq",
              "keyValue": "={{ $json.updated_at }}"
            }
          ]
        },
        "matchType": "allConditions"
      }
    },
    {
      "id": "21341cb1-c6e0-4569-9a49-140b8b902b9e",
      "name": "🧾 only a 204 is done",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "jsCode": "const sent = $('✔️ mark done').all();\nreturn $input.all().map((item, i) => {\n  const t = sent[i]?.json ?? {};\n  if (item.json.statusCode !== 204) throw new Error(`github answered ${item.json.statusCode} for thread ${t.thread} (${t.repo})`);\n  return { json: t };\n});"
      }
    }
