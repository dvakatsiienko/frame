{
  "bashOutputMaxChars": 8000,
  "env": {
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  },
  "permissions": {
    "additionalDirectories": ["/Users/dima/frame"],
    "deny": [
      "Skill(adhd:adhd)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/dima/frame/cclio/.claude/hooks/boot-prefetch.sh"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/dima/frame/cclio/.claude/hooks/shift-recompact.sh"
          },
          {
            "type": "command",
            "command": "/Users/dima/frame/cclio/.claude/hooks/compact-carry.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr merge*)",
            "command": "pnpm -C /Users/dima/frame --silent ccrow:decision",
            "timeout": 120
          },
          {
            "type": "command",
            "if": "Bash(claude *)",
            "command": "pnpm -C /Users/dima/frame --silent ccrow:decision",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/dima/frame/cclio/.claude/hooks/pocket-check-on-write.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm -C /Users/dima/frame --silent ccrow:decision",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm -C /Users/dima/frame --silent ccrow:relay",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r .transcript_path | xargs -I{} pnpm -C /Users/dima/frame --silent ccrow:wake --transcript {}",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "/Users/dima/frame/cclio/.claude/hooks/pocket-mirror.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "pnpm -C /Users/dima/frame --silent ccrow:unvetted",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r .transcript_path | xargs -I{} pnpm -C /Users/dima/frame --silent ccrow:wake --transcript {} --precompact",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "cclio@cclio": true,
    "neuroarxiv@neuroarxiv": true,
    "adhd@adhd": true,
    "fast-jev-compaction@fast-jev-compaction": false,
    "cc-plugin-you-should-know@builtin": true
  },
  "extraKnownMarketplaces": {
    "cclio": {
      "source": {
        "source": "directory",
        "path": "/Users/dima/frame/cclio/plugin-cclio"
      }
    },
    "neuroarxiv": {
      "source": {
        "source": "github",
        "repo": "UditAkhourii/neuroarxiv"
      },
      "autoUpdate": true
    },
    "adhd": {
      "source": {
        "source": "github",
        "repo": "UditAkhourii/adhd"
      }
    }
  }
}
