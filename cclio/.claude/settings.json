{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/dima/frame/cclio/.claude/hooks/boot-prefetch.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "cclio@cclio": true,
    "neuroarxiv@neuroarxiv": true,
    "adhd@adhd": true
  },
  "extraKnownMarketplaces": {
    "cclio": {
      "source": {
        "source": "directory",
        "path": "/Users/dima/frame/cclio/plugin-cclio"
      }
    },
    "neuroarxiv": {
      "source": {
        "source": "github",
        "repo": "UditAkhourii/neuroarxiv"
      },
      "autoUpdate": true
    },
    "adhd": {
      "source": {
        "source": "github",
        "repo": "UditAkhourii/adhd"
      }
    }
  },
  "permissions": {
    "deny": [
      "Skill(adhd:adhd)"
    ]
  }
}
