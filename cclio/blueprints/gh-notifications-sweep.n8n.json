    {
      "name": "✅ settled only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        160
      ],
      "parameters": {
        "jsCode": "return $input.all()\n  .map((item, i) => ({ t: $('📖 already read?').itemMatching(i).json, body: item.json.body, status: item.json.statusCode }))\n  .filter(({ t, body, status }) => status === 200 && (t.kind === 'pr' ? body.state === 'closed' : Array.isArray(body) && body.length === 0))\n  .map(({ t }) => ({ json: { thread: t.thread, repo: t.repo, kind: t.kind, title: t.title, updated_at: t.updated_at, swept_at: t.swept_at } }));"
      },
      "id": "341daf94-f4e4-4bd4-8761-2b6f086cb955"
    },
