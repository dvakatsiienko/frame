    {
      "name": "🔀 the threads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const out = [];\nconst now = new Date().toISOString();\nfor (const { json: n } of $input.all()) {\n  const repo = n.repository.full_name;\n  const base = { thread: n.id, repo, title: n.subject.title, updated_at: n.updated_at, swept_at: now };\n  if (!n.unread) { out.push({ json: { ...base, kind: 'read' } }); continue; }\n  if (n.subject.type === 'PullRequest') {\n    out.push({ json: { ...base, kind: 'pr', check: n.subject.url } });\n  } else if (n.subject.type === 'CheckSuite') {\n    const branch = n.subject.title.match(/for (.+) branch$/)?.[1];\n    if (!branch) continue;\n    out.push({ json: { ...base, kind: 'ci', check: `https://api.github.com/repos/${repo}/pulls?state=open&head=${repo.split('/')[0]}:${encodeURIComponent(branch)}` } });\n  }\n}\nreturn out;"
      },
      "id": "5671288a-775b-499d-8276-02c1b9122b85"
    },
