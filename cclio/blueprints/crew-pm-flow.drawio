        <mxCell id="tf-b6-head" value="✍️ 6 — shaping and the sign: who says yes?" style="strokeColor=none;fillColor=none;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica Neue;fontSize=40;fontStyle=1;fontColor=#1E1E1E;" parent="tf-b6" vertex="1">
          <mxGeometry x="56" y="40" width="2400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="tf-b6-src" value="cclio:shape-idea · cclio:shape-lane · craft-pm § wishes · craft-fleet-flow stages 2–4" style="strokeColor=none;fillColor=none;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica Neue;fontSize=22;fontStyle=0;fontColor=#1E1E1E;" parent="tf-b6" vertex="1">
          <mxGeometry x="56" y="100" width="2400" height="27" as="geometry" />
        </mxCell>
        <mxCell id="tf-b6-idea" value="&lt;b style=&quot;font-size:26px&quot;&gt;🦉 shape-idea, a pick&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;a new app, a feature, a changed product part: want + grill, prior art, the cut, the &lt;b&gt;done test&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;cclio:shape-idea steps 1–6&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#C2E5FF;strokeColor=#3DADFF;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b6" vertex="1">
          <mxGeometry x="56" y="200" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b6-out" value="&lt;b style=&quot;font-size:26px&quot;&gt;📄 one shaped ticket&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;&lt;b&gt;wish&lt;/b&gt;, decided, the cut as out, the 🎯 &lt;b&gt;done test&lt;/b&gt;; no files: PRODUCT.md is born at &lt;b&gt;dispatch&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;cclio:shape-idea step 7&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#FFECBD;strokeColor=#FFC943;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b6" vertex="1">
          <mxGeometry x="686" y="200" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b6-plain" value="&lt;b style=&quot;font-size:26px&quot;&gt;🎫 plain work: a full ticket&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;mechanical wishes skip &lt;b&gt;shape-idea&lt;/b&gt;, folded straight into a full ticket, never a thin one&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;craft-pm § wishes · cclio:pm&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#C2E5FF;strokeColor=#3DADFF;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b6" vertex="1">
          <mxGeometry x="1316" y="200" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b6-prep" value="&lt;b style=&quot;font-size:26px&quot;&gt;🙋‍♂️ you start a sign&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;you say «prep», «sign» or «next chunk» («fast» for many); the ticket enters &lt;b&gt;shape-lane&lt;/b&gt;, a &lt;b&gt;wish&lt;/b&gt; &lt;b&gt;signed&lt;/b&gt; on the spot folds first&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;cclio:shape-lane&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#DCCCFF;strokeColor=#874FFF;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b6" vertex="1">
          <mxGeometry x="56" y="570" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b6-read" value="&lt;b style=&quot;font-size:26px&quot;&gt;🦉 read what is settled&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;the &lt;b&gt;wish&lt;/b&gt; block + decided; each round&amp;#x27;s proposal file passes the wish-cover hook&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;shape-lane § 0&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#C2E5FF;strokeColor=#3DADFF;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b6" vertex="1">
          <mxGeometry x="686" y="570" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b6-card" value="&lt;b style=&quot;font-size:26px&quot;&gt;📄 the chunk card&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;an h2 + two lines: why we have it, what we want out of it&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;shape-lane § 1&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#FFECBD;strokeColor=#FFC943;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b6" vertex="1">
          <mxGeometry x="1316" y="570" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b6-mode" value="&lt;b style=&quot;font-size:26px&quot;&gt;❓ single or fast?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;single: one chunk per grill, the default; fast on his word: a triage first, only chunks needing no call of his&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;shape-lane § 2&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#C2E5FF;strokeColor=#3DADFF;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b6" vertex="1">
          <mxGeometry x="1946" y="570" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b6-grill" value="&lt;b style=&quot;font-size:26px&quot;&gt;🙋‍♂️ the grill&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;matt&amp;#x27;s ❓ rounds, the frontier only; a fast chunk is self-grilled by cclio, fully groomed&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;shape-lane § 2&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#DCCCFF;strokeColor=#874FFF;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b6" vertex="1">
          <mxGeometry x="2576" y="570" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b6-fields" value="&lt;b style=&quot;font-size:26px&quot;&gt;📄 what the sign carries&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;&lt;b&gt;done test&lt;/b&gt; · &lt;b&gt;milestone&lt;/b&gt; · lane kind · repo · blocks order · merge: pre-approved for guards or merge-auto&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;shape-lane § 3&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#FFECBD;strokeColor=#FFC943;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b6" vertex="1">
          <mxGeometry x="3206" y="570" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b6-sign" value="&lt;b style=&quot;font-size:26px&quot;&gt;✍️ his whole answer is the sign&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;a grill answered whole signs it; a fast chunk gets one ✍️ ask; a steer takes it back&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;shape-lane § 4&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#DCCCFF;strokeColor=#874FFF;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b6" vertex="1">
          <mxGeometry x="3206" y="940" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b6-block" value="&lt;b style=&quot;font-size:26px&quot;&gt;📄 the ## signed block&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;«✍️ &lt;b&gt;signed&lt;/b&gt; &amp;lt;date&amp;gt; · body &amp;lt;hash&amp;gt;», appended, never edited; every later body write adds a line&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;shape-lane § 4 · body.md&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#FFECBD;strokeColor=#FFC943;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b6" vertex="1">
          <mxGeometry x="2576" y="940" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b6-resign" value="&lt;b style=&quot;font-size:26px&quot;&gt;🔁 a re-sign&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;a changed &lt;b&gt;signed&lt;/b&gt; ticket goes through &lt;b&gt;shape-lane&lt;/b&gt; again; a tiny change skips the grill, never the line&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;shape-lane § 4 · fleet-flow § lane init&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#C2E5FF;strokeColor=#3DADFF;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b6" vertex="1">
          <mxGeometry x="1946" y="940" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b6-w-hash" value="&lt;b style=&quot;font-size:26px&quot;&gt;⚠️ nothing enforces the line&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;a body write without its ## &lt;b&gt;signed&lt;/b&gt; line shows only at &lt;b&gt;dispatch&lt;/b&gt;&amp;#x27;s hash check; the guard rides FRM-384&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;my reading · shape-lane § 4&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#FFDBDB;strokeColor=#E54D4D;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b6" vertex="1">
          <mxGeometry x="1316" y="940" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b6-main" value="&lt;b style=&quot;font-size:26px&quot;&gt;🐋 the main lane signs too&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;our own steps as one chunk, lane: main, no &lt;b&gt;coder&lt;/b&gt;, no &lt;b&gt;spec&lt;/b&gt;; &lt;b&gt;glide&lt;/b&gt; is its progress — a trial (FRM-419)&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;fleet-flow § lane init&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#C2E5FF;strokeColor=#3DADFF;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b6" vertex="1">
