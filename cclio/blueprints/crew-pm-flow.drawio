        <mxCell id="tf-title" value="🗺️ tickets flow — how a ticket lives today, across the pocket and linear" style="strokeColor=none;fillColor=none;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica Neue;fontSize=48;fontStyle=1;fontColor=#1E1E1E;" parent="1" vertex="1">
