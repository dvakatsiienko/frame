        <mxCell id="tf-b7-src" value="cclio:shape-lane-dispatch (+ exit-lines.md) · x:crew-lead · craft-fleet-flow § lane init, stage 5" style="strokeColor=none;fillColor=none;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica Neue;fontSize=22;fontStyle=0;fontColor=#1E1E1E;" parent="tf-b7" vertex="1">
          <mxGeometry x="56" y="100" width="2400" height="27" as="geometry" />
        </mxCell>
        <mxCell id="tf-b7-offer" value="&lt;b style=&quot;font-size:26px&quot;&gt;🙋‍♂️ «what can we dispatch?»&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;&lt;b&gt;signed&lt;/b&gt;, unblocked chunks by &lt;b&gt;milestone&lt;/b&gt;; a hash off its last sign line → a &lt;b&gt;re-sign&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;shape-lane-dispatch § 1&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#DCCCFF;strokeColor=#874FFF;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b7" vertex="1">
          <mxGeometry x="56" y="200" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b7-lane" value="&lt;b style=&quot;font-size:26px&quot;&gt;🛼 a lane = one milestone&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;its &lt;b&gt;signed&lt;/b&gt; chunks in blocks order, one &lt;b&gt;glide&lt;/b&gt; step each; a shift walks milestones in queue order&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;fleet-flow § lane init&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#FFECBD;strokeColor=#FFC943;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b7" vertex="1">
          <mxGeometry x="686" y="200" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b7-spec" value="&lt;b style=&quot;font-size:26px&quot;&gt;📐 the spec&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;.scratch/&amp;lt;feature&amp;gt;/spec.md, &lt;b&gt;wish&lt;/b&gt;: FRM-N, a section per chunk; PRODUCT.md for an app, skill or tool&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;shape-lane-dispatch § 2 · to-spec&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#FFECBD;strokeColor=#FFC943;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b7" vertex="1">
          <mxGeometry x="1316" y="200" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b7-exit" value="&lt;b style=&quot;font-size:26px&quot;&gt;🦉 the exit lines&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;3–6 given/when/then per chunk, the want line last, seeded from the 🎯 &lt;b&gt;done test&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;dispatch § 3 · exit-lines.md&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#C2E5FF;strokeColor=#3DADFF;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b7" vertex="1">
          <mxGeometry x="1946" y="200" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b7-critic" value="&lt;b style=&quot;font-size:26px&quot;&gt;🐦‍⬛ the blind critic&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;&lt;b&gt;ccrow&lt;/b&gt;:plan-critique sees only the want + the lines; each finding folded&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;shape-lane-dispatch § 3&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#FFE0C2;strokeColor=#FF9E42;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b7" vertex="1">
          <mxGeometry x="2576" y="200" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b7-seal" value="&lt;b style=&quot;font-size:26px&quot;&gt;🦭 the seal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;x brief preflight passes; the print collapses to «🦭 &lt;b&gt;sealed&lt;/b&gt;, N &lt;b&gt;exit lines&lt;/b&gt;»&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;shape-lane-dispatch § 4&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#CDF4D3;strokeColor=#66D575;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b7" vertex="1">
          <mxGeometry x="3206" y="200" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b7-spawn" value="&lt;b style=&quot;font-size:26px&quot;&gt;📋 the spawn&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;x:crew-lead: a fresh &lt;b&gt;coder&lt;/b&gt;, a &lt;b&gt;verifier&lt;/b&gt; by default; the brief runs to-tickets first, its quiz skipped&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;shape-lane-dispatch § 5&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#C2E5FF;strokeColor=#3DADFF;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b7" vertex="1">
          <mxGeometry x="2576" y="570" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b7-dispatched" value="&lt;b style=&quot;font-size:26px&quot;&gt;🚀 dispatched&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;the &lt;b&gt;signed&lt;/b&gt; label off, In Progress, «🚀 &lt;b&gt;dispatched&lt;/b&gt; &amp;lt;date&amp;gt;» appended; a cancel: Canceled + «🚫 cancelled»&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;shape-lane-dispatch § 5&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#FFECBD;strokeColor=#FFC943;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b7" vertex="1">
          <mxGeometry x="1946" y="570" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b7-plan" value="&lt;b style=&quot;font-size:26px&quot;&gt;📄 the lane plan&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;~/.local/state/x/lanes/&amp;lt;feature&amp;gt;/lane-plan.md: the &lt;b&gt;coder&lt;/b&gt;&amp;#x27;s ticket order&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;dispatch § 5 · how-you-work.md&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#FFECBD;strokeColor=#FFC943;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b7" vertex="1">
