        <mxCell id="tf-b7-head" value="🚀 7 — dispatch: how does a signed chunk become a running lane?" style="strokeColor=none;fillColor=none;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica Neue;fontSize=40;fontStyle=1;fontColor=#1E1E1E;" parent="tf-b7" vertex="1">
