        <mxCell id="tf-b3-stays" value="&lt;b style=&quot;font-size:26px&quot;&gt;🏃 pocket: today or tomorrow&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;no, and soon: the &lt;b&gt;main lane&lt;/b&gt;&amp;#x27;s scope, cclio&amp;#x27;s open questions, shapeless ideas; no count cap&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;habit-shared-files § the pocket&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#C2E5FF;strokeColor=#3DADFF;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b3" vertex="1">
