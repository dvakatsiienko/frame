        <mxCell id="tf-b7-green" value="&lt;b style=&quot;font-size:26px&quot;&gt;🟢 the greenlight&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;cclio reorders it against what comes next, final word; again after a [progress] ping&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;shape-lane-dispatch § 5&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#C2E5FF;strokeColor=#3DADFF;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b7" vertex="1">
          <mxGeometry x="686" y="570" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b7-joiner" value="&lt;b style=&quot;font-size:26px&quot;&gt;➕ a joiner&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;a &lt;b&gt;signed&lt;/b&gt; chunk of the same &lt;b&gt;milestone&lt;/b&gt;: a new &lt;b&gt;spec&lt;/b&gt; section, a &lt;b&gt;glide&lt;/b&gt; step, a steer&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;shape-lane-dispatch § 6&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#C2E5FF;strokeColor=#3DADFF;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b7" vertex="1">
