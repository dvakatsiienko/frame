        <mxCell id="tf-b2-chore" value="&lt;b style=&quot;font-size:26px&quot;&gt;🎼 a pocket-write chore&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;a write with its fields known goes to &lt;b&gt;composer&lt;/b&gt;; one that needs wording stays cclio&amp;#x27;s&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;habit-shared-files § the pocket&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#FFE0C2;strokeColor=#FF9E42;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b2" vertex="1">
