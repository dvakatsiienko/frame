        <mxCell id="tf-b7-park" value="&lt;b style=&quot;font-size:26px&quot;&gt;🅿️ a park&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;a call only dima can make parks the chunk, its reason in the &lt;b&gt;spec&lt;/b&gt;; a shift takes the next&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;dispatch § 6 · fleet-flow § lane init&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#C2E5FF;strokeColor=#3DADFF;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b7" vertex="1">
