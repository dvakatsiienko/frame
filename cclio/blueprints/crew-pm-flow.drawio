        <mxCell id="tf-b1-head" value="🚪 1 — a drop is born: how does his want enter?" style="strokeColor=none;fillColor=none;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica Neue;fontSize=40;fontStyle=1;fontColor=#1E1E1E;" parent="tf-b1" vertex="1">
          <mxGeometry x="56" y="40" width="2400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="tf-b1-src" value="habit-shared-files § the obsidian channel · cclio:boot step 3 · craft-pm § wishes · craft-fleet-flow stage 1" style="strokeColor=none;fillColor=none;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica Neue;fontSize=22;fontStyle=0;fontColor=#1E1E1E;" parent="tf-b1" vertex="1">
          <mxGeometry x="56" y="100" width="2400" height="27" as="geometry" />
        </mxCell>
        <mxCell id="tf-b1-drop" value="&lt;b style=&quot;font-size:26px&quot;&gt;🔔 dima drops a want&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;a line in the vault &lt;b&gt;inbox&lt;/b&gt; from his phone, or a mid-session prompt&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;_hq/inbox.md · boot step 3&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#D9D9D9;strokeColor=#B3B3B3;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b1" vertex="1">
          <mxGeometry x="56" y="200" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b1-groom" value="&lt;b style=&quot;font-size:26px&quot;&gt;🎼 composer grooms it&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;inbox-prep at boot; a wish-bearing prompt → prompt-groom.ts before its fold, a miss reds in pocket-check&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;boot step 3 · craft-pm § wishes · FRM-418&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#FFE0C2;strokeColor=#FF9E42;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b1" vertex="1">
          <mxGeometry x="686" y="200" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b1-parse" value="&lt;b style=&quot;font-size:26px&quot;&gt;🦉 the parse&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;EVERY item, the smallest aside too, gets a &lt;b&gt;pocket&lt;/b&gt; item and its place in the order&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;boot step 3 · fleet-flow stage 1&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#C2E5FF;strokeColor=#3DADFF;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b1" vertex="1">
          <mxGeometry x="1316" y="200" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b1-wlines" value="&lt;b style=&quot;font-size:26px&quot;&gt;📄 numbered W-lines&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;his fold, one point per line W1…, ❓ marks his questions; the raw drop stays in the notes&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;craft-pm § wishes&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#FFECBD;strokeColor=#FFC943;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b1" vertex="1">
          <mxGeometry x="1946" y="200" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b1-keeper" value="&lt;b style=&quot;font-size:26px&quot;&gt;🐬 wishkeeper checks meaning&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;every ask of the raw &lt;b&gt;inbox&lt;/b&gt; kept in meaning, not only present&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;boot step 3 (step 8&amp;#x27;s brief)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#FFE0C2;strokeColor=#FF9E42;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b1" vertex="1">
          <mxGeometry x="686" y="570" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b1-elsewhere" value="&lt;b style=&quot;font-size:26px&quot;&gt;🔔 an ask born elsewhere&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;a grill, a sweep plan, a log or test-drive line: it gets a home too, never that line alone&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;habit-shared-files § the pocket&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#D9D9D9;strokeColor=#B3B3B3;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b1" vertex="1">
          <mxGeometry x="1316" y="570" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tf-b1-cover" value="&lt;b style=&quot;font-size:26px&quot;&gt;⚙️ wish-cover.ts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;a first use copies only the W-lines it settles, read from the ticket&amp;#x27;s &lt;b&gt;wish&lt;/b&gt; block first, else its &lt;b&gt;pocket&lt;/b&gt; item; its hook blocks a red&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;craft-pm § wishes&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#CDF4D3;strokeColor=#66D575;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b1" vertex="1">
