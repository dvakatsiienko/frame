        <mxCell id="tf-b5-dispatched" value="&lt;b style=&quot;font-size:26px&quot;&gt;🚀 dispatched&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;the &lt;b&gt;coder&lt;/b&gt; starts: In Progress, the &lt;b&gt;coder&lt;/b&gt; app as delegate, the &lt;b&gt;signed&lt;/b&gt; label off&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;font-size:16px;color:#5C5C5C&quot;&gt;shape-lane-dispatch § 5&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=80;fillColor=#FFE0C2;strokeColor=#FF9E42;strokeWidth=3;fontFamily=Helvetica Neue;fontColor=#1E1E1E;spacingLeft=20;spacingRight=20;spacing=8;" parent="tf-b5" vertex="1">
