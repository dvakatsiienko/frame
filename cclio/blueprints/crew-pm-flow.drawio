        <mxCell id="tf-b6" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;container=1;collapsible=0;fillColor=#EFF4FF;strokeColor=#CED2DB;strokeWidth=2;noLabel=1;" parent="1" vertex="1">
