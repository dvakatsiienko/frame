#!/usr/bin/env bash
# ftr-gate <commit-msg-file> — a lefthook commit-msg job in frame and bytes. a commit that stages an app's code
# stages that app's FTR.md too, or its body carries the line `ftr: none` (a refactor, a fix with no feature change).
# an app is the nearest dir above a staged file that holds FTR.md, or the FTR.md whose `claims:` line (within its
# first 10 lines, comma-separated path prefixes) names the file — speak's map claims the x-speak daemon that way.
# docs, skills, config and assets pass untouched: only code counts.
set -euo pipefail

msg=${1:?usage: ftr-gate <commit-msg-file>}
grep -qE '^ftr: none[[:space:]]*$' "$msg" && exit 0

staged=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -z "$staged" ] && exit 0

# «<prefix> <ftr path>» per claimed prefix
claims=$(git ls-files -- '*FTR.md' | while read -r ftr; do
    head -10 "$ftr" | sed -n 's/^claims: //p' | tr ',' '\n' | tr -d '`' | sed 's/^ *//; s/ *$//' |
        while read -r prefix; do [ -n "$prefix" ] && echo "$prefix $ftr"; done
done)

missing=""
while read -r file; do
    case "$file" in *.ts | *.tsx | *.js | *.jsx | *.mjs | *.css | *.swift | *.html) ;; *) continue ;; esac
    case "/$file" in */.claude/plugin-x/mods/*) ;; */.claude/*) continue ;; esac
    ftr=""
    dir=$(dirname "$file")
    while [ "$dir" != "." ] && [ "$dir" != "/" ]; do
        if [ -f "$dir/FTR.md" ]; then ftr="$dir/FTR.md"; break; fi
        dir=$(dirname "$dir")
    done
    if [ -z "$ftr" ] && [ -n "$claims" ]; then
        while read -r prefix owner; do
            case "$file" in "$prefix"*) ftr=$owner ;; esac
        done <<<"$claims"
    fi
    [ -z "$ftr" ] && continue
    grep -qxF "$ftr" <<<"$staged" || missing="$missing
$ftr"
done <<<"$staged"

[ -z "$missing" ] && exit 0
sort -u <<<"$missing" | sed '/^$/d' | while read -r ftr; do
    echo "ftr-gate: $(dirname "$ftr")'s code is staged without $ftr — stage its ftr line, or add a bare line «ftr: none» to the commit body when no feature changed — no bullet, no indent"
done
exit 1
