#!/usr/bin/env bash
# red-proof <file> <anchor> <replacement> <test> — proves a test reads <file>: green on the file as it is, red with
# the anchor swapped, then the file restored byte for byte. exit 0 only on green-then-red.
# red-proof --pairs <pairs> <file> <test> — the same for many anchors, each swapped alone; exit 0 only
# when every pair went red.
# --cmd first, then `-- <command…>` in place of <test>: runs any command (`claude plugin test <mod>`) instead of vitest.
set -u
usage() {
  echo "usage: red-proof <file> <anchor> <replacement> <test>" >&2
  echo "       red-proof --pairs <pairs> <file> <test>   (pairs: one 'anchor<TAB>replacement' per line, split on the last tab, # and blank lines skipped)" >&2
  echo "       red-proof --cmd <file> <anchor> <replacement> -- <command…>" >&2
  echo "       red-proof --cmd --pairs <pairs> <file> -- <command…>" >&2
  exit 2
}
cmd=()
if [ "${1-}" = --cmd ]; then
  shift
  args=()
  while [ $# -gt 0 ] && [ "$1" != -- ]; do args+=("$1"); shift; done
  [ "${1-}" = -- ] && [ $# -gt 1 ] && [ ${#args[@]} -gt 0 ] || usage
  shift
  cmd=("$@")
  # go test caches results; a cached green hides the mutation
  if [ "${cmd[0]}" = go ] && [ "${cmd[1]-}" = test ] && [[ " ${cmd[*]} " != *" -count"* ]]; then
    cmd=(go test -count=1 "${cmd[@]:2}")
  fi
  set -- "${args[@]}" "${cmd[*]}"
fi
# each run's output is kept: a swap that breaks the load fails every test whatever it reads, so it is named apart from a red
out=$(mktemp)
run() {
  if [ ${#cmd[@]} -gt 0 ]; then "${cmd[@]}"; else npx vitest run "$test"; fi >"$out" 2>&1
}
LOAD_ERROR='SyntaxError|did not load|Cannot find module|ERR_MODULE_NOT_FOUND|Failed to load|Transform failed|\[setup failed\]|\[build failed\]'
anchors=() replacements=()
if [ "${1-}" = --pairs ]; then
  [ $# -eq 4 ] || usage
  pairs=$2 file=$3 test=$4
  [ -f "$pairs" ] || { echo "red-proof: no pairs file $pairs" >&2; exit 2; }
  n=0
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    case $line in '' | '#'*) continue ;; esac
    case $line in *$'\t'*) ;; *) echo "red-proof: $pairs:$n has no tab between anchor and replacement" >&2; exit 2 ;; esac
    # the LAST tab splits a pair, so an anchor keeps its leading tabs (go is tab-indented); a replacement holds none
    [ -n "${line%$'\t'*}" ] || { echo "red-proof: $pairs:$n has an empty anchor" >&2; exit 2; }
    anchors+=("${line%$'\t'*}") replacements+=("${line##*$'\t'}")
  done < "$pairs"
  [ ${#anchors[@]} -gt 0 ] || { echo "red-proof: $pairs holds no pairs" >&2; exit 2; }
else
  [ $# -eq 4 ] || usage
  file=$1 anchors=("$2") replacements=("$3") test=$4
fi
[ -f "$file" ] || { echo "red-proof: no file $file" >&2; exit 2; }
for anchor in "${anchors[@]}"; do
  count=$(ANCHOR="$anchor" python3 -c 'import os,sys; print(open(sys.argv[1]).read().count(os.environ["ANCHOR"]))' "$file")
  [ "$count" = 1 ] || { echo "red-proof: anchor «${anchor}» found $count times in $file, needs exactly 1" >&2; exit 2; }
done

# on a red base every swap reads RED whatever it does (FRM-478: the mod never loaded), so it refuses before the first swap
if ! run; then
  names=$(sed -nE -e 's/ \[[0-9.]+ms\]$//' -e 's/^ *\(fail\) //p' -e 's/^ *FAIL +//p' -e 's/^ *--- FAIL: ([^ ]+).*/\1/p' "$out" | sort -u)
  if [ -n "$names" ]; then
    echo "red-proof: the base is already red, nothing swapped: $(printf '%s\n' "$names" | wc -l | tr -d ' ') failed" >&2
    printf '%s\n' "$names" | sed 's/^/  /' >&2
  else
    echo "red-proof: the base is already red, nothing swapped: no failed name read, its output ends:" >&2
    tail -5 "$out" | sed 's/^/  /' >&2
  fi
  rm -f "$out"
  exit 1
fi

backup=$(mktemp)
cp -p "$file" "$backup"
# touch: a build cache keyed on mtime (the x shim) must not keep the mutated build
restore() { cp -p "$backup" "$file"; touch "$file"; }
trap 'restore; rm -f "$backup" "$out"' EXIT
trap 'exit 130' INT TERM

all_red=1
for i in "${!anchors[@]}"; do
  ANCHOR="${anchors[$i]}" REPL="${replacements[$i]}" python3 -c 'import os,sys; p=sys.argv[1]; s=open(p).read(); open(p,"w").write(s.replace(os.environ["ANCHOR"],os.environ["REPL"],1))' "$file"
  if run; then red=0; else red=1; fi
  restore
  label="mutated"
  [ "${1-}" = --pairs ] && label="«${anchors[$i]}»"
  if [ $red = 1 ] && grep -Eq "$LOAD_ERROR" "$out"; then
    echo "✗     ${label}: the run did not load — a load error, not a failing test; its output ends:"
    tail -5 "$out" | sed 's/^/      /'
    all_red=0
  elif [ $red = 1 ]; then
    echo "RED   ${label}: the test failed, as it should"
  else
    echo "✗     ${label}: the test still passed — it does not read this line"
    all_red=0
  fi
done
cmp -s "$backup" "$file" || { echo "✗     restore: $file differs from its original" >&2; exit 1; }
echo "GREEN restored: the base passed, and the file is back byte for byte"
[ $all_red = 1 ]
