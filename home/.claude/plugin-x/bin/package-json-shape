#!/usr/bin/env node
/**
 * ? package-json-shape — check every manifest in a workspace against the
 * ? convention, print what drifted, exit non-zero if anything did.
 * ?
 * ?   package-json-shape            # the workspace at the cwd
 * ?   package-json-shape .          # the same, said out loud (lefthook uses this)
 * ?   package-json-shape ~/projects/bytes
 * ?
 * ? The rules live one import away in `../lib/package-json-shape.ts` — inside the plugin, so the cached copy on a session's PATH finds them too, beside
 * ? the tests that hold them; this file is argv, printing and the exit code. The
 * ? convention it enforces is
 * ? `plugin-x/skills/guide-conventions/conventions/package-json.md` — the check
 * ? sits next to the rule it enforces, so any repo can run it rather than each
 * ? one carrying a copy.
 * ?
 * ? No extension and no build on purpose: node 24 detects module syntax in an
 * ? extensionless entry and strips types from the `.ts` it imports, so the file
 * ? on PATH is the source.
 */

/* Core */
import { resolve } from 'node:path';

/* Instruments */
import {
    checkManifest,
    checkVersionAgreement,
    findManifestPaths,
    readManifest,
} from '../lib/package-json-shape.ts';

const root = resolve(process.argv[2] ?? '.');
// ? Extra args narrow the check to those manifests — a pre-commit hook passes
// ? its staged files, so one drifting manifest elsewhere never blocks an
// ? unrelated commit; the repo-wide sweep belongs to ci.
const only = process.argv.slice(3).filter((path) => path.endsWith('package.json'));
const manifests = only.length > 0 ? only : findManifestPaths(root);

if (manifests.length === 0) {
    console.error(`no package.json found under ${root}`);
    process.exit(1);
}

let failed = 0;

for (const rel of manifests) {
    const problems = checkManifest(readManifest(root, rel));
    if (problems.length === 0) continue;

    failed += 1;
    console.error(`\n${rel}`);
    for (const problem of problems) console.error(`  ${problem}`);
}

// ? One version per name is the only rule a single manifest cannot answer, so it
// ? always compares the WHOLE workspace even when the args narrowed the rest.
// ? `only` then narrows the reporting, so a stale drift elsewhere still never
// ? blocks an unrelated commit — see checkVersionAgreement.
const everyManifest = only.length > 0 ? findManifestPaths(root) : manifests;
const disagreements = checkVersionAgreement(
    everyManifest.map((rel) => ({ path: rel, manifest: readManifest(root, rel) })),
    only.length > 0 ? only : undefined,
);

for (const problem of disagreements) console.error(`\n  ${problem}`);

const scope = `${manifests.length} manifest${manifests.length === 1 ? '' : 's'}`;

if (failed > 0 || disagreements.length > 0) {
    if (failed > 0) console.error(`\n${failed} of ${scope} off the convention shape`);
    if (disagreements.length > 0) {
        const count = disagreements.length;
        console.error(`${count} name${count === 1 ? '' : 's'} pinned to more than one version`);
    }
    process.exit(1);
}

console.log(`${scope} on the convention shape, one version per name`);
