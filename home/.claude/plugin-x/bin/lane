#!/usr/bin/env bash
# lane — kept for running coders; the verbs live in the x cli now (`x lane --help`).
# the old lane published without asking, so the publishing verbs get --apply here;
# `pr-open --dry-run` maps to x's plan (no --apply).
here=$(realpath "${BASH_SOURCE[0]}")
x=${here%/home/.claude/plugin-x/bin/lane}/x/bin/x
verb=${1:-}
case ${verb} in
    commit | push | merge-main | unlock) shift; exec "${x}" lane "${verb}" --apply "$@" ;;
    pr-open)
        shift
        if [[ ${1:-} == --dry-run ]]; then shift; exec "${x}" lane pr-open "$@"; fi
        exec "${x}" lane pr-open --apply "$@"
        ;;
    *) exec "${x}" lane ;;
esac
