#!/usr/bin/env bash
# linear-as <member> <linear args…> — runs the linear cli as a fleet app (coder, cclio), never as dima.
# the token is minted inside the script, so the command text carries no export for the worktree guard.
set -u
usage() { echo "usage: linear-as <coder|cclio> <linear args…>" >&2; exit 2; }
[ $# -ge 2 ] || usage
member=$1; shift
case $member in coder | cclio) ;; *) usage ;; esac
token=$(node "$HOME/frame/script/linear-agent-token.ts" "$member") && [ -n "$token" ] ||
  { echo "linear-as: no token for $member" >&2; exit 1; }
LINEAR_API_KEY=$token exec linear "$@"
