#!/usr/bin/env bash
# github-token-wrap — run one `gh` call as the coder app (x-coder-cc).
# every gh call that WRITES to a pr or issue in our repos goes through this,
# so the post wears the app and never dima. usage: github-token-wrap pr comment 76 --body …
set -euo pipefail
[ "${1:-}" = gh ] && shift  # a leading `gh` is tolerated: two briefs wrote `github-token-wrap gh pr …`
GH_TOKEN=$(cd ~/frame && pnpm --silent github:agent-token) exec gh "$@"
