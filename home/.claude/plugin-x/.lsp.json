{
    "typescript": {
        "args": ["${CLAUDE_PROJECT_DIR}"],
        "command": "${CLAUDE_PLUGIN_ROOT}/bin/ts-lsp",
        "extensionToLanguage": {
            ".cjs": "javascript",
            ".cts": "typescript",
            ".js": "javascript",
            ".jsx": "javascriptreact",
            ".mjs": "javascript",
            ".mts": "typescript",
            ".ts": "typescript",
            ".tsx": "typescriptreact"
        },
        "startupTimeout": 60000,
        "workspaceFolder": "${CLAUDE_PROJECT_DIR}"
    }
}
