{
    "typescript": {
        "args": [
            "${CLAUDE_PLUGIN_ROOT}/lsp/typescript-native/scripts/launch.mjs"
        ],
        "command": "node",
        "extensionToLanguage": {
            ".cjs": "javascript",
            ".cts": "typescript",
            ".js": "javascript",
            ".jsx": "javascriptreact",
            ".mjs": "javascript",
            ".mts": "typescript",
            ".ts": "typescript",
            ".tsx": "typescriptreact"
        },
        "startupTimeout": 60000,
        "workspaceFolder": "${CLAUDE_PROJECT_DIR}"
    }
}
