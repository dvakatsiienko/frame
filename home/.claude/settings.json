{
  "cleanupPeriodDays": 90,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "skillListingBudgetFraction": 0.025,
  "env": {
    "EDITOR": "nvim",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "0",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/frame/home/.claude/plugin-x/mods/breather:~/frame/home/.claude/plugin-x/mods/stash:~/frame/home/.claude/plugin-x/mods/redact:~/frame/home/.claude/plugin-x/mods/guard",
    "CLAUDE_CODE_PLUGIN_DIR_WATCH": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Workflow"
    ],
    "deny": [
      "NotebookEdit",
      "CronCreate",
      "CronDelete",
      "CronList",
      "AskUserQuestion",
      "EnterPlanMode",
      "ExitPlanMode"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "~"
    ]
  },
  "model": "opus[1m]",
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/shelf/hooks/zsh-equals-guard.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/shelf/hooks/bg-deadline-guard.py"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/shelf/hooks/memory-load-agents-md.py"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/shelf/hooks/memory-load-rule-lazy.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/shelf/hooks/authoring-guard.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/shelf/hooks/sline-focus.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/shelf/hooks/opus-register.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/shelf/hooks/skill-route.sh"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/shelf/hooks/memory-load-rule-lazy.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/shelf/hooks/notification-host-reply.sh"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/shelf/hooks/reply-check.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/shelf/hooks/memory-load-rule-lazy.py"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/shelf/hooks/notification-spawn-init.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/shelf/hooks/notification-spawn-reply.sh SubagentStop"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/shelf/hooks/notification-spawn-reply.sh TaskCompleted"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/shelf/hooks/opus-register-capture.sh"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/shelf/hooks/memory-load-rule-lazy.py"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/shelf/hooks/crew-recompact.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/shelf/hooks/worktree-seed.sh",
            "timeout": 600,
            "statusMessage": "worktree seed"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/shelf/hooks/biome-format.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "disableAgentView": false,
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/sline/bin",
    "padding": 0,
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "x@x": true,
    "impeccable@impeccable": true,
    "typesafe@typesafe-ai": true,
    "humanize@humanize": true,
    "cc-plugin-telemetry@builtin": false,
    "mindful-claude@mindful-claude": false,
    "cc-plugin-you-should-know@builtin": true,
    "show-me@skills": true,
    "mattpocock-skills@mattpocock": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      },
      "autoUpdate": true
    },
    "x": {
      "source": {
        "source": "directory",
        "path": "~/frame/home/.claude/plugin-x"
      },
      "autoUpdate": true
    },
    "linear-cli": {
      "source": {
        "source": "github",
        "repo": "schpet/linear-cli"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "xiaolai": {
      "source": {
        "source": "github",
        "repo": "xiaolai/claude-plugin-marketplace"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    },
    "humanize": {
      "source": {
        "source": "github",
        "repo": "harshaneel/humanize"
      },
      "autoUpdate": true
    },
    "fast-jev-compaction": {
      "source": {
        "source": "github",
        "repo": "tamaratran/fast-jev-compaction"
      }
    },
    "mindful-claude": {
      "source": {
        "source": "github",
        "repo": "halluton/Mindful-Claude"
      }
    },
    "skills": {
      "source": {
        "source": "github",
        "repo": "humanlayer/skills"
      },
      "autoUpdate": true
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "output-fun",
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "low"
    },
    "claude-fable-5": {
      "effortLevel": "low"
    },
    "claude-fable-5-1": {
      "effortLevel": "low"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "fastModePerSessionOptIn": true,
  "pluginConfigs": {
    "fast-jev-compaction@fast-jev-compaction": {
      "options": {
        "compactAtPercent": 95,
        "model": "jev-1.13.0",
        "preserveRecentMessages": 10,
        "truncateHeadChars": 500
      }
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:gruvbox-ansi",
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "notifications_disabled",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "leftArrowOpensAgents": false
}
