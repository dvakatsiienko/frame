[user]
	name = Dima Vakatsiienko
	email = imagnum.satellite@gmail.com
	# public half of the 1Password SSH key that signs every commit
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILnChnk8JuZUBynotPPornPGEoRPZcOtK9srvd5QP91M

[core]
	# opens for a commit with no -m
	editor = nvim
	# normalise CRLF on the way into a commit; the worktree is left alone
	autocrlf = input
	# syntax-highlighted, navigable diffs. git skips the pager when stdout is not
	# a tty, so scripts and agents still get a plain unified diff — measured
	# 2026-09-03. never use diff.external for this: that one DOES run non-tty.
	pager = delta

[gpg]
	# sign with the ssh key above, not a gpg key
	format = ssh

# Measured 2026-08-28, because "it works by luck" turned out to be wrong: signing
# survives an unset SSH_AUTH_SOCK, a bogus one, and a bare `env -i` PATH —
# op-ssh-sign reaches 1Password directly rather than through the ssh agent.
# The ONE hard failure is the path below. Move, rename or uninstall 1Password and
# every commit dies with "failed to write commit object", which does not name the
# cause. allowedSignersFile only decides whether `git verify-commit` succeeds
# HERE; it never affects whether a commit gets signed.
[gpg "ssh"]
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
	allowedSignersFile = ~/.ssh/allowed_signers

[commit]
	# every commit signed, so github shows the verified badge
	gpgsign = true
	# put the diff in the editor, so `mana` shows what is being committed
	verbose = true

[pull]
	# rebase instead of a merge bubble on every pull
	rebase = true

[rebase]
	# fixup!/squash! commits fold on their own, no -i needed
	autoSquash = true
	# a rebase carries branches pointing into the range; without this a stacked
	# branch is silently left behind on the old commits
	updateRefs = true

[merge]
	# the conflict marker also shows the common ancestor, so you can see what each
	# side changed instead of guessing
	conflictStyle = zdiff3

[diff]
	# better hunk boundaries than the default myers, especially on moved code
	algorithm = histogram

[rerere]
	# remember how a conflict was resolved and replay it next time — bg coders
	# rebase the same branches onto a moving main over and over
	enabled = true

[fetch]
	# drop remote-tracking refs for branches deleted on the remote. this is what
	# makes the [gone] marker trustworthy, and `gprune` reads [gone] to decide
	prune = true

[branch]
	# newest branch first in `git branch`
	sort = -committerdate

[tag]
	# newest tag first, version-aware rather than alphabetical
	sort = -v:refname
	# tags signed like commits
	gpgsign = true

[push]
	# a first push creates its own upstream; no --set-upstream dance
	autoSetupRemote = true

[interactive]
	# delta colours `git add -p` too, without going near diff.external
	diffFilter = delta --color-only

[delta]
	# n/N jump between files in a diff
	navigate = true
	line-numbers = true
	# same theme as bat (BAT_THEME in .zshenv), so the two match
	syntax-theme = gruvbox-dark
	dark = true

# Recipes, not keystroke savers: these live here rather than in zsh because a git
# alias resolves everywhere git runs — scripts, `git -C`, another shell, an
# agent's non-interactive bash. Short two-letter shortcuts stay in aliases.zsh,
# where saving keystrokes is the whole point.
[pretty]
	# the one look every recipe below shares: hash · age · subject · author · refs
	fleet = format:%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)

[alias]
	# the map: one line per commit, every ref, conductor checkpoints excluded
	lg = "log --graph --abbrev-commit --decorate --pretty=fleet --exclude=refs/conductor-checkpoints/* --all"
	# what landed today, across every branch
	ship = "log --since=midnight --pretty=fleet --all"
	# the last two days with weekday and clock — the standup answer
	standup = "log --since=2.days.ago --pretty=fleet"
	# local branches, newest first, with whether the upstream is gone
	br = "branch --sort=-committerdate --format='%(color:bold blue)%(refname:short)%(color:reset)  %(color:bold green)%(committerdate:relative)%(color:reset)  %(color:bold yellow)%(upstream:track)%(color:reset)'"
	# this branch against main: the commits it adds, then the files it touches.
	# three dots on the diff, so it reads the merge-base and not main's own moves
	vs = "!f() { b=${1:-HEAD}; git log --pretty=fleet main..$b; echo; git diff --stat main...$b; }; f"
	# who wrote this repo: agent commits carry a Co-Authored-By trailer, dima's do not
	# the trailer was spelled a dozen ways before x:cmt fixed the canon — the sed map folds them
	who = "!git log --format='%(trailers:key=Co-authored-by,valueonly)' | sed -E 's/ <.*//; s/(claude-opus-5(\\[1m\\])?|opus-5|Opus 5 \\(1M context\\))/Opus 5/; s/(claude-fable-5|fable-5)$/Fable 5/' | grep . | sort | uniq -c | sort -rn"
	# label a staged fix as belonging to <hash>; the next reforge folds it in (rebase.autoSquash)
	fixup = commit --fixup
	# take one commit onto HEAD; -x records "(cherry picked from …)" in the new body
	pick = cherry-pick -x
	# status with a face: branch pill, drift, last commit, the tree grouped by state
	sup = "!~/.config/git/sup.sh"
	# pick from a branch: fzf over the commits main lacks, multi-select with tab, oldest first
	pickfrom = "!f() { git log --reverse --pretty=fleet main..\"$1\" | fzf --ansi --multi --no-sort | awk '{print $1}' | xargs -r git cherry-pick -x; }; f"
	# what the last commit touched
	last = "show --stat --format=format:'%C(bold blue)%h%C(reset) %C(white)%s%C(reset) %C(dim white)- %an, %ar%C(reset)' HEAD"
	# the files that changed most in 90 days — where the pain lives
	churn = "!git log --since=90.days.ago --format= --name-only | grep . | sort | uniq -c | sort -rn | head -20"

# git-lfs wiring. required=true means a repo with lfs-tracked files fails to CLONE
# without the git-lfs binary, so the Brewfile carries it.
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[init]
	defaultBranch = main

# pushes to an https github remote go over ssh, so they use the 1Password key; fetches stay
# https — a fetch rewritten to ssh hangs on a fresh mac until 1Password is signed in (FRM-147)
[url "git@github.com:"]
	pushInsteadOf = https://github.com/
[coderabbit]
	machineId = cli/1b1584fc4c1f445a8a3f1fa406c2b793
